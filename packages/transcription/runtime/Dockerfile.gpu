FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 SONAVRA_MODEL_CACHE=/models/whisper SONAVRA_DIARIZATION_MODEL=/models/diarization SONAVRA_TRANSCRIPTION_DEVICE=cuda SONAVRA_TRANSCRIPTION_COMPUTE_TYPE=float16
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /runtime
COPY requirements.txt ./
RUN python3 -m pip install --upgrade pip && python3 -m pip install -r requirements.txt
COPY whisper_runtime.py runtime_check.py provision_models.py ./
RUN mkdir -p "$SONAVRA_MODEL_CACHE" "$SONAVRA_DIARIZATION_MODEL"
VOLUME ["/models"]
CMD ["python3", "runtime_check.py"]
