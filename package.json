{
  "name": "sonavra",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm dev:setup && dotenv -e .env -e .env.defaults -- pnpm --parallel --filter './apps/*' dev",
    "dev:setup": "docker compose up -d --wait postgres && pnpm db:deploy && pnpm db:generate",
    "dev:web": "dotenv -e .env -e .env.defaults -- pnpm --filter @sonavra/web dev",
    "dev:api": "dotenv -e .env -e .env.defaults -- pnpm --filter @sonavra/api dev",
    "dev:worker": "dotenv -e .env -e .env.defaults -- pnpm --filter @sonavra/worker dev",
    "db:generate": "dotenv -e .env -e .env.defaults -- pnpm --filter @sonavra/database db:generate",
    "db:migrate": "dotenv -e .env -e .env.defaults -- pnpm --filter @sonavra/database db:migrate",
    "db:deploy": "dotenv -e .env -e .env.defaults -- pnpm --filter @sonavra/database db:deploy",
    "db:studio": "dotenv -e .env -e .env.defaults -- pnpm --filter @sonavra/database db:studio",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  }
}
