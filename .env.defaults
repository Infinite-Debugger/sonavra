# App
WEB_PORT=3000
API_PORT=3001

# Database
POSTGRES_PORT=5432
POSTGRES_DB=sonavra
POSTGRES_USER=sonavra
POSTGRES_PASSWORD=sonavra
DATABASE_URL=postgresql://sonavra:sonavra@localhost:5432/sonavra

# Transcription
SONAVRA_TRANSCRIPTION_RUNTIME_CONTAINER=sonavra-transcription-runtime
SONAVRA_TRANSCRIPTION_MODEL=small
SONAVRA_TRANSCRIPTION_DEVICE=cpu
SONAVRA_TRANSCRIPTION_COMPUTE_TYPE=int8

# Object storage
S3_PORT=9000
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=sonavra
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=sonavra
S3_SECRET_ACCESS_KEY=sonavra-local-secret

# Guest recordings and transcripts
SONAVRA_GUEST_RETENTION_HOURS=24

# Optional local transcript summaries (disabled until a model is configured)
# SONAVRA_SUMMARY_MODEL=your-local-model
# SONAVRA_SUMMARY_URL=http://localhost:11434

# Internal services and processing limits
API_HOST=127.0.0.1
SONAVRA_WORKER_HEALTH_PORT=3002
SONAVRA_MAX_DURATION_SECONDS=14400
# Production requires a random SONAVRA_HEALTH_TOKEN with at least 32 URL-safe characters.
# Rate limiting is always enabled in production; opt in during development with:
# SONAVRA_RATE_LIMITING=true
# Trust forwarding headers only behind the sanitizing private ingress in ops/Caddyfile.
# SONAVRA_TRUST_PROXY=true
